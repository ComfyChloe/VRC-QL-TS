{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRC Launcher",
  "version": "0.1.0",
  "identifier": "dev.comfychloe.vrc-launcher",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRC Launcher",
        "width": 960,
        "height": 740,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#161616"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
